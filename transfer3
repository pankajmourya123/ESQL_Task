package com.cedge.BeneNameMain;

import java.io.*;

public class CBS_Details {

	public static String getIpAndPort(String bankPrefix, String propFilePath) {

		if (propFilePath == null || propFilePath.isEmpty()) {
			return "Error: PROPFILE UDP is not set";
		}

		File file = new File(propFilePath);
		if (!file.exists() || !file.canRead()) {
			return "Error: File does not exist or cannot be read at path: " + propFilePath;
		}

		if (bankPrefix == null || bankPrefix.trim().length() != 4) {
			return "Error: Invalid bank prefix. It must be exactly 4 characters.";
		}

		String output = "";

		try (BufferedReader br = new BufferedReader(new FileReader(file))) {
			String line;
			while ((line = br.readLine()) != null) {
				String[] parts = line.split("\\|");

				if (parts.length < 3) {
					continue;
				}

				String prefix = parts[0].trim();
				String ip = parts[1].trim();
				String port = parts[2].trim();

				if (prefix.equalsIgnoreCase(bankPrefix)) {
					output = ip + " " + port;
					break;
				}
			}
		} catch (IOException e) {
			return "Error reading file: " + e.getMessage();
		}

		return output.isEmpty() ? "No matching bank found for prefix: " + bankPrefix : output;
	}

	public static void main(String[] args) {
		// Test the function manually (not needed in ACE, but useful for debugging)
		String propFilePath = "/var/config/cbs_details.txt"; // Replace with actual path
		String bankPrefix = "HDFC"; // Example prefix

		String result = getIpAndPort(bankPrefix, propFilePath);
		System.out.println("Result: " + result);
	}
}
