<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE UFM_Workflow SYSTEM "UFM_Workflow.dtd">
<UFM_Workflow>
  <Actions>
    <Watch pollinterval="5">
      <WatchItem type="D">
        <Directory sendonstartup="Y">/var/iib/interface/pankaj</Directory>
        <Extension>TXT</Extension>
        <Actions>
          <MQSend delete="Y" format="S">
            <File>${WATCH_FOUND_FILE}</File>
            <MQ>
              <MQFile>IIB_MQFILE.xml</MQFile>
              <QueueName>CBS170.TO.IIBRDNB.NEFT.OUT</QueueName>
              <BackOutQName>CBS170.TO.IIBRDNB.NEFT.OUT.FAIL</BackOutQName>
            </MQ>
          </MQSend>
          <Move>
            <Source>${WATCH_FOUND_FILE}</Source>
            <Destination>/var/iib/interface/pallavi/</Destination>
          </Move>
        </Actions>
      </WatchItem>
    </Watch>
  </Actions>
</UFM_Workflow>
