

  /opt/mqm/Capitalware/UFM/script/Pankaj_test
UFM_COUNT=`ps -ef |grep ${LOGNAME} | grep -v grep | grep "/opt/mqm/Capitalware/UFM/workflow/Pankaj_test.xml"|wc -l`
/usr/bin/date
if [ ${UFM_COUNT} -gt 0 ]
then
        echo "UFM Pankaj_test is already Running.........."
else
        echo "Starting UFM Pankaj_test"
        nohup /opt/mqm/Capitalware/UFM/UFM.sh /opt/mqm/Capitalware/UFM/workflow/Pankaj_test.xml > /dev/null &
fi
	  
	  
	  
