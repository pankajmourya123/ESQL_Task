package com.cedge.BeneNameMain;

import com.ibm.broker.javacompute.MbJavaComputeNode;
import java.io.*;
import java.net.Socket;
import java.net.SocketTimeoutException;
import java.nio.charset.StandardCharsets;
import com.ibm.broker.plugin.*;

public class BenNameFinder_JavaCompute extends MbJavaComputeNode {

    public void evaluate(MbMessageAssembly assembly) throws MbException {
        MbMessage env = assembly.getGlobalEnvironment();
        MbElement root = env.getRootElement();

        // Retrieve values from Environment variables
        String requestMessage = getEnvironmentVariable(root, "Variables/TCPRequest");
        String serverIP = getEnvironmentVariable(root, "Variables/IP");
        String serverPortStr = getEnvironmentVariable(root, "Variables/PORT");

        // Validate environment variables
        if (requestMessage == null || serverIP == null || serverPortStr == null) {
            throwException("400", "Missing required environment variables (TCPRequest, IP, PORT)");
        }

        int serverPort = 0;
        try {
            serverPort = Integer.parseInt(serverPortStr);
            if (serverPort < 1 || serverPort > 65535) {
                throwException("400", "Port number out of valid range (1-65535): " + serverPortStr);
            }
        } catch (NumberFormatException e) {
            throwException("400", "Invalid port number format: " + serverPortStr);
        }

        System.out.println("Connecting to server: " + serverIP + " on port: " + serverPort);
        System.out.println("Sending TCP request: " + requestMessage);

        // Create socket connection
        try (Socket socket = new Socket(serverIP, serverPort);
             BufferedWriter bufferedWriter = new BufferedWriter(new OutputStreamWriter(socket.getOutputStream(), StandardCharsets.UTF_8));
             BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(socket.getInputStream(), StandardCharsets.UTF_8))) {

            // Set socket timeout (10 seconds)
            socket.setSoTimeout(10000);

            // Send request data
            bufferedWriter.write(requestMessage);
            bufferedWriter.newLine();
            bufferedWriter.flush();

            // Read response from TCP server
            String response = bufferedReader.readLine();
            if (response == null || response.isEmpty()) {
                throwException("500", "Received empty response from server");
            }

            System.out.println("Received TCP response: " + response);

            // Store response in Environment
            root.createElementAsLastChild(MbElement.TYPE_NAME_VALUE, "TCPResponse", response);

        } catch (SocketTimeoutException e) {
            throwException("408", "TCP connection timed out");
        } catch (IOException e) {
            throwException("500", "I/O Error: " + e.getMessage());
        } catch (Exception e) {
            throwException("500", "Unexpected Error: " + e.getMessage());
        }
    }

    /**
     * Utility method to retrieve environment variables safely.
     */
    private String getEnvironmentVariable(MbElement root, String path) throws MbException {
        MbElement element = root.getFirstElementByPath(path);
        return (element != null) ? element.getValueAsString() : null;
    }

    /**
     * Utility method to throw an exception with an error code and message.
     */
    private void throwException(String errorCode, String errorMessage) throws MbUserException {
        System.err.println("Error [" + errorCode + "]: " + errorMessage);
        throw new MbUserException(this, "evaluate", "", "", "Error Code: " + errorCode + ", Message: " + errorMessage, null);
    }
}
