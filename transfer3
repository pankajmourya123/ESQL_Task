CREATE COMPUTE MODULE BenNameFinder_Compute
	DECLARE Config EXTERNAL CHARACTER;
	DECLARE PROP_LOC EXTERNAL CHARACTER '';
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE httpMethod CHARACTER;
    
    -- Get the HTTP method from the request
    SET httpMethod = SUBSTRING(InputRoot.HTTPInputHeader."X-Original-HTTP-Command" FROM 1 FOR 4);

    -- Allow only POST requests
    IF httpMethod <> 'POST' THEN
        SET OutputRoot.HTTPReplyHeader."Content-Type" = 'application/json';
        SET OutputRoot.HTTPReplyHeader."X-Error-Message" = '405 Method Not Allowed';
        SET OutputRoot.HTTPResponseHeader.StatusCode = 405;
        
        RETURN FALSE;
    END IF;
    
		-- CALL CopyMessageHeaders();
		 CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1; 
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE inref REFERENCE TO InputRoot.XMLNSC.BeneNameLookUpApiRequest;
		DECLARE payload, bankPrefix, IP, PORT,CBS_Details,requestString,result CHARACTER;
		
		DECLARE rc BOOLEAN; 
		
		CALL initLog4j(Config) INTO rc; 
		SET payload = CAST(ASBITSTREAM(InputRoot.XMLNSC CCSID InputRoot.Properties.CodedCharSetId ENCODING InputRoot.Properties.Encoding) AS CHARACTER CCSID InputRoot.Properties.CodedCharSetId ENCODING InputRoot.Properties.Encoding); 
		SET Environment.payload = payload;
		 CALL log4j_1_1('BANL', 'BeneficiaryDetails', 'INFO','-------------------------START logging -------------------------') INTO rc;
         CALL log4j_1_1('LOGGING', 'BeneficiaryDetails', 'INFO','Request data:'||payload) INTO rc;
         
		SET Environment.Variables.IFSC = inref.IFSC;
		SET Environment.Variables.AccountNumber = inref.account_number;
		
        SET bankPrefix = SUBSTRING(inref.IFSC FROM 1 FOR 4);
		SET Environment.PROPFILE = PROP_LOC;
		CALL log4j_1_1('LOGGING', 'BeneficiaryDetails', 'INFO','BankName:'||bankPrefix) INTO rc;
		CALL log4j_1_1('LOGGING', 'BeneficiaryDetails', 'INFO','PropertieFilePath:'||PROP_LOC) INTO rc;
		
			 CALL GetPROP(bankPrefix,PROP_LOC) INTO CBS_Details;  
			
			 CALL log4j_1_1('LOGGING', 'BeneficiaryDetails', 'INFO','CBS IP and PORT:'||CBS_Details) INTO rc;
             SET Environment.Variables.IP = SUBSTRING(CBS_Details BEFORE ' ');
             SET Environment.Variables.PORT = SUBSTRING(CBS_Details AFTER ' ');
             
             
        DECLARE accountNum CHARACTER FIELDVALUE(InputRoot.XMLNSC.BeneNameLookUpApiRequest.account_number);    
        SET requestString = 'TX:: 0156                    **  000026    003000100000006163060460000000000     0         00000000        000000000000000000000000000000000000'||accountNum||'   5000000A';
        SET Environment.Variables.TCPRequest = requestString;
        CALL log4j_1_1('LOGGING', 'BeneficiaryDetails', 'INFO','CBS Req_STRING:'||requestString) INTO rc;
        
		       
	END; 	
END MODULE;
