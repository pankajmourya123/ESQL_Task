DECLARE sourceCursor REFERENCE TO InputExceptionList;
MOVE sourceCursor FIRSTCHILD TYPE Name NAME 'ParserException';

DECLARE targetCursor REFERENCE TO OutputRoot.JSON.Data.Exception;
DECLARE childCursor REFERENCE TO sourceCursor;  -- Cursor for iterating child fields

WHILE LASTMOVE(sourceCursor) DO
    -- Iterate through all child elements inside 'ParserException'
    MOVE childCursor FIRSTCHILD;
    
    WHILE LASTMOVE(childCursor) DO
        -- Print child name and value dynamically
        SET targetCursor.Type  = FIELDNAME(childCursor);
        SET targetCursor.Value = FIELDVALUE(childCursor);
        
        -- Move to the next sibling
        CREATE NEXTSIBLING OF targetCursor AS targetCursor;
        MOVE childCursor NEXTSIBLING;
    END WHILE;
    
    -- Move to the next 'ParserException' sibling if exists
    MOVE sourceCursor NEXTSIBLING REPEAT TYPE NAME;
END WHILE;
