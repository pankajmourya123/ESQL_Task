DECLARE count INT 0;

-- Loop through the array and count the elements
FOR P AS InputRoot.JSON.Data[] DO
    SET count = count + 1;
END FOR;

-- Set the count in the output
SET OutputRoot.JSON.Data.Count = count;


DECLARE count INT 0;

-- Loop through the array and count occurrences of a specific roll_no
FOR P AS InputRoot.JSON.Data[] DO
    IF P.roll_no = '12345' THEN
        SET count = count + 1;
    END IF;
END FOR;

-- Set the count for this specific roll_no in the output
SET OutputRoot.JSON.Data.Count = count;
