

CREATE COMPUTE MODULE dofileekoutput_Compute
	DECLARE shrvar SHARED CHARACTER;
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;



	CREATE PROCEDURE CopyEntireMessage() BEGIN
	
		
		
		DECLARE jsonString BLOB;

		SET jsonString = ASBITSTREAM(
		InputRoot.JSON.Data
		ENCODING 0
		CCSID 1208 -- Assuming UTF-8 encoding
		SET '' -- Assuming no specific message set
		TYPE '' -- Assuming no specific message type
		FORMAT '' -- Assuming no specific message format
		OPTIONS ValidateNone -- No validation options
		);
		
		
		SET OutputRoot.BLOB.BLOB = jsonString;		
			DECLARE temp BLOB;
		SET temp=CAST(jsonString AS BLOB CSID 1208);
		SET shrvar=temp;
		
		
		
		
		
		DECLARE xmlString BLOB;

		SET xmlString = ASBITSTREAM(
		InputRoot.XMLNSC
		ENCODING 0
		CCSID 1208 -- Assuming UTF-8 encoding
		SET '' -- Assuming no specific message set
		TYPE '' -- Assuming no specific message type
		FORMAT '' -- Assuming no specific message format
		OPTIONS ValidateNone -- No validation options
		);
		-- Set the output message to the string representation
		SET OutputRoot.BLOB.BLOB = xmlString;
		DECLARE temp2 BLOB;
		SET temp2=CAST(xmlString AS BLOB CSID 1208);
		SET shrvar=temp2;
		
	END;
END MODULE;
