		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE NEXTSIBLING OF "OutputRoot"."Properties" DOMAIN 'MQMD' NAME 'MQMD';
		SET OutputRoot.MQMD.Format = 'MQHRF2';
		CREATE NEXTSIBLING OF "OutputRoot"."MQMD" DOMAIN 'MQRFH2' NAME 'MQRFH2';
		SET OutputRoot.MQRFH2.(MQRFH2.Field)Version = 2;
		SET OutputRoot.MQRFH2.(MQRFH2.Field)Format = 'MQSTR';
		SET OutputRoot.MQRFH2.(MQRFH2.Field)NameValueCCSID = 1208;
		SET OutputRoot.MQRFH2.usr.filename = InputLocalEnvironment.File.Name;
		SET OutputRoot.DFDL = InputRoot.DFDL;
		
		SET OutputLocalEnvironment.Destination.MQ.DestinationData[1].queueName=GATEWAY;
--		SET OutputLocalEnvironment.Destination.MQ.DestinationData[2].queueName = MIRROR;
		
	END;
