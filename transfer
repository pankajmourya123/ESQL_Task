DECLARE soapenv NAMESPACE 'xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/';

DECLARE tran NAMESPACE 'xmlns:tran="http://tempuri.org/Transaction'; 


CREATE COMPUTE MODULE MySoapFlow_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE inref1 REFERENCE TO InputRoot.SOAP.Body.transactionreq;
		DECLARE inref2 REFERENCE TO InputRoot.SOAP.Body.*:transactionreq;		


		CREATE FIELD OutputRoot.SOAP.Body.*:transactionres;

		Set OutputRoot.SOAP.Context.Namespace.(SOAP.NamespaceDecl)xmlns:soapenv =soapenv;

		set OutputRoot.SOAP.Context.Namespace.(SOAP.NamespaceDecl)xmlns:tran =tran;

		DECLARE outRef REFERENCE TO OutputRoot.SOAP.Body.tran:transactionres;

		SET outRef.tran:Status ='Transaction is sucessful';

		RETURN TRUE;
	END;	


END MODULE;


