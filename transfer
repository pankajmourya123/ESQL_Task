CREATE PROCEDURE CopyEntireMessage() BEGIN
	
		 DECLARE MyMessage REFERENCE TO OutputRoot.JSON.Data;
		
		CREATE FIELD LASTCHILD
		OF MyMessage
		AS MyNewField
		DOMAIN MyDomain
		REPEAT VALUE -10
			VALUE 20
			TYPE VARCHAR(255)
			NAMESPACE 'http://example.com/myNamespace'
			NAME 'MyFieldName'
			IDENTITY MyIdentityField
			FROM SourceField
			PARSE (
			BitStreamExpression << ENCODING 'UTF-8'
			CCSID 1208
			SET 'MySet'
			TYPE 'MyType'
			FORMAT 'MyFormat'
			OPTIONS 'MyOptions'
			);

		END;
	END MODULE;
