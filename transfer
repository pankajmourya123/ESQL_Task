DECLARE inputData CHARACTER;
DECLARE errorMessage CHARACTER;

-- JSON/XML parsing attempt
SET inputData = FIELDNAME(InputRoot.JSON.Data); 

-- Agar field missing hai ya format galat hai, toh exception throw karein
IF inputData IS NULL THEN
    SET errorMessage = 'Parsing Exception: Invalid or missing data in request';
    
    THROW USER EXCEPTION 
    SEVERITY 3 
    CATALOG 'BIPmsgs' 
    MESSAGE 2951 
    VALUES(errorMessage);
END IF;
