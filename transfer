	        END IF;
		    
			DECLARE signature CHARACTER;
			CALL getProperties( Environment.pfxfile, Environment.pfxpass,fourBlock,signature);
			SET signature = signature ;
			DECLARE sigmsg CHARACTER;
			SET sigmsg = signature;
