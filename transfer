CREATE COMPUTE MODULE Timepass_Compute
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        DECLARE srcCursor REFERENCE TO InputRoot.XMLNSC.root;
        DECLARE trgCursor REFERENCE TO OutputRoot.XMLNSC.root;
        DECLARE count INTEGER 0;

        -- Start the loop to iterate over source XML elements
        X: WHILE LASTMOVE(srcCursor) DO
            -- Create the next sibling in the target
            CREATE NEXTSIBLING OF trgCursor AS trgCursor;

            -- Move to the next sibling in the source
            MOVE srcCursor NEXTSIBLING;

            -- Set the count value and increment
            SET count = count + 1;

            -- Break the loop after 10 elements
            IF count = 10 THEN
                LEAVE X;
            END IF;
        END WHILE;

        -- Return true to indicate successful execution
        RETURN TRUE;
    END;
END MODULE;
