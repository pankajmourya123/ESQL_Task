CREATE COMPUTE MODULE Task_Compute

    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        CALL CopyEntireMessage();
        RETURN TRUE;
    END;

    CREATE PROCEDURE CopyEntireMessage() 
    BEGIN
        -- Initialize variables
        DECLARE lineCount INTEGER 0;
        DECLARE currentLine REFERENCE TO InputRoot.BLOB.BLOB;  -- Adjust based on actual input structure
        DECLARE outputLines BLOB;  -- To store the output lines
        DECLARE lineData CHARACTER;

        -- Initialize output as an empty BLOB
        SET outputLines = CAST('' AS BLOB CCSID 1208); 

        -- Traverse through the input lines using FIRSTCHILD and NEXTSIBLING
        SET currentLine = FIRSTCHILD(InputRoot.BLOB.BLOB);  -- Adjust according to your input structure

        WHILE currentLine IS NOT NULL DO
            IF lineCount < 10 THEN
                -- Extract the line data (adjust structure if necessary)
                SET lineData = CAST(currentLine AS CHARACTER CCSID 1208);

                -- Append the line to the output (with newline)
                SET outputLines = outputLines || CAST(lineData AS BLOB CCSID 1208) || CAST(CHAR(10) AS BLOB CCSID 1208); 
                SET lineCount = lineCount + 1;
            ELSE
                LEAVE;  -- Exit the loop after processing 10 lines
            END IF;

            -- Move to the next sibling line
            SET currentLine = NEXTSIBLING(currentLine);
        END WHILE;

        -- Set the output root to the constructed output
        SET OutputRoot.BLOB.BLOB = outputLines;
    END;

END MODULE;
