CREATE COMPUTE MODULE APCOB_NEFT_OUTWARD_GATEWAY
	DECLARE UDP EXTERNAL CHARACTER;

	 DECLARE DQN10 EXTERNAL CHARACTER '';
	 DECLARE DQN06N07 EXTERNAL CHARACTER '';
	 DECLARE MIRROR EXTERNAL CHARACTER '';
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE rc BOOLEAN;
		DECLARE sType CHARACTER InputRoot.DFDL.*.Header.SUBMESSAGETYPE;
		CALL initLog4j(UDP) INTO rc;
		
		CALL log4j_1_1('GATEWAY', 'APCOB_NEFT_OUTWARD_GATEWAY', 'WARN','-------------------------------------START-------------------------------------') INTO rc;
		CALL log4j_1_1('GATEWAY', 'APCOB_NEFT_OUTWARD_GATEWAY', 'WARN','File received from CBS ') INTO rc;
		CALL log4j_1_1('GATEWAY', 'APCOB_NEFT_OUTWARD_GATEWAY', 'WARN','File Name : '||InputRoot.MQRFH2.usr.UFM_FileName) INTO rc;
		CALL log4j_1_1('GATEWAY', 'APCOB_NEFT_OUTWARD_GATEWAY', 'WARN','Message Type is : '||InputRoot.DFDL.*.Header.SUBMESSAGETYPE) INTO rc;

		
		DECLARE bool BOOLEAN;
		CALL CopyMessageHeaders();
		SET bool = CopyEntireMessage();	
		
--		DECLARE ExcRef REFERENCE TO InputExceptionList.*;
--		IF NOT LASTMOVE(ExcRef) THEN
			CALL log4j_1_1('GATEWAY', 'APCOB_NEFT_OUTWARD_GATEWAY', 'WARN','--------------------------------------END--------------------------------------') INTO rc;	
--		END IF;
					
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;


CREATE PROCEDURE CopyEntireMessage() RETURNS BOOLEAN BEGIN
		
		DECLARE sType , destinationQ CHARACTER;


		SET sType = InputRoot.DFDL.*.Header.SUBMESSAGETYPE;	
		DECLARE rc BOOLEAN;
		IF sType = 'N10' THEN
			SET OutputLocalEnvironment.Destination.MQ.DestinationData[1].queueName = DQN10;
			CALL log4j_1_1('GATEWAY LOG', 'APCOB_NEFT_OUTWARD_GATEWAY', 'WARN','Destination Queue : APCOB.NEFT.OUT.GATEWAY.N10') INTO rc;

			SET OutputRoot.DFDL = InputRoot.DFDL;

		ELSE 

			SET OutputLocalEnvironment.Destination.MQ.DestinationData[1].queueName = DQN06N07;
			CALL log4j_1_1('GATEWAY LOG', 'APCOB_NEFT_OUTWARD_GATEWAY', 'WARN','Destination Queue : CEDGERRB.NEFT.OUT.GATEWAY.ISO ') INTO rc;

			SET OutputRoot.DFDL = InputRoot.DFDL;
		END IF;
--		RETURN TRUE;
			SET OutputLocalEnvironment.Destination.MQ.DestinationData[2].queueName = MIRROR;	
	END;
	
END MODULE;
