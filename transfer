   -- Only propagate when both JSON and XML data have been processed
        IF LENGTH(TRIM(shrvar)) > 0 THEN
            -- Prepare output message
            SET OutputRoot.Properties.MessageFormat = 'XML';
            SET OutputRoot.BLOB.BLOB = CAST(shrvar AS BLOB CCSID 1208);

            -- Send concatenated output to FileOutputNode
            PROPAGATE;
            
            -- Reset shared variable after propagation to avoid duplicate writes
            ATOMIC
            BEGIN
                SET shrvar = ''; 
            END;
        END I
