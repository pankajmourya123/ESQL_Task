CREATE COMPUTE MODULE flow1_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE inputData CHARACTER;
		DECLARE errorMessage CHARACTER;
	
		-- Attempt to fetch input data
		SET inputData = FIELDNAME(InputRoot.JSON.Data);
	
		-- Check if data is null
		IF inputData IS NULL THEN
			SET errorMessage = 'Parsing Exception: Invalid or missing input data';
			
			-- Explicitly Throw User Exception
			THROW USER EXCEPTION
			SEVERITY 3
			CATALOG 'BIPmsgs'
			MESSAGE 2951
			VALUES(errorMessage);
		END IF;
		
	END;
END MODULE;
CREATE COMPUTE MODULE sub_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;	

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE i INTEGER 1;
		DECLARE count INTEGER;
		SET count = CARDINALITY(InputExceptionList.*[]);

		-- Initialize Output Exception List
		SET OutputRoot.JSON.Data.Status = 'Error';
		SET OutputRoot.JSON.Data.Exception = NULL;
		
		-- Loop through captured exceptions
		WHILE i <= count DO
			-- Extract details
			SET OutputRoot.JSON.Data.Exception[i].Number = InputExceptionList[i].Number;
			SET OutputRoot.JSON.Data.Exception[i].Text = InputExceptionList[i].Text;
			SET OutputRoot.JSON.Data.Exception[i].Type = FIELDNAME(InputExceptionList[i]);

			-- Check for user exception message and update response
			IF InputExceptionList[i].Text CONTAINS 'Parsing Exception' THEN
				SET OutputRoot.JSON.Data.Message = InputExceptionList[i].Text;
			END IF;

			SET i = i + 1;
		END WHILE;		
	END;
END MODULE;
