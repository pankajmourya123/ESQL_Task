DECLARE nodesherll SHARED INTEGER 0;
DECLARE flowsharll SHARED ROW;

CREATE COMPUTE MODULE ComputeNode1
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Node-Shared Variable (Will reset for different compute nodes)
        SET nodesherll = nodesherll + 1;

        -- Flow-Shared Variable (Will persist across all compute nodes in the flow)
        IF NOT EXISTS(flowsharll.counter) THEN
            SET flowsharll.counter = 0;
        END IF;
        SET flowsharll.counter = flowsharll.counter + 1;

        -- Store results in JSON output
        SET OutputRoot.JSON.Data.NodeSharedValue = nodesherll;
        SET OutputRoot.JSON.Data.FlowSharedValue = flowsharll.counter;
    END;
END MODULE;

CREATE COMPUTE MODULE ComputeNode2
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Node-Shared Variable (Will not get updated from ComputeNode1)
        SET OutputRoot.JSON.Data.NodeSharedValue = nodesherll;

        -- Flow-Shared Variable (Will persist from ComputeNode1)
        SET OutputRoot.JSON.Data.FlowSharedValue = flowsharll.counter;
    END;
END MODULE;
