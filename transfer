CREATE COMPUTE MODULE MyComputeNode
  CREATE FUNCTION Main() RETURNS BOOLEAN
  BEGIN
    DECLARE OutputMsg REFERENCE TO OutputRoot;
    DECLARE RequestPayload CHARACTER;
    
    -- Extract input data
    SET RequestPayload = InputRoot.JSON.Data.value;

    -- Handling scope of variables
    DECLARE Variable1 CHAR 'Existing variable';

    BEGIN
      -- Inside BEGIN block
      DECLARE Variable1 CHAR 'Local variable';
      SET OutputMsg.JSON.Data.LocalScopeExample = Variable1;
    END;

    -- Demonstrating ATOMIC for thread safety on shared variables
    DECLARE Count SHARED INT;

    SharedCounterUpdate : BEGIN ATOMIC
      SET Count = Count + 1;
    END;

    -- Using Exception Handling inside BEGIN...END
    DECLARE ErrorMsg CHARACTER;
    BEGIN
      DECLARE OrderDate DATE;
      -- Simulate an operation that may fail
      SET OrderDate = CAST(RequestPayload AS DATE FORMAT 'YYYY-MM-DD');
    EXCEPTION
      WHEN SQLSTATE LIKE '22%' DO
        SET ErrorMsg = 'Invalid date format';
        LEAVE; -- Exit execution on error
    END;

    -- Returning response
    SET OutputMsg.JSON.Data.Count = Count;
    SET OutputMsg.JSON.Data.OrderDate = OrderDate;
    SET OutputMsg.JSON.Data.ErrorMessage = ErrorMsg;

    RETURN TRUE;
  END;
END MODULE;
