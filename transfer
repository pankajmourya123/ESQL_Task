DECLARE myvar CHARACTER;
DECLARE myblob BLOB;
DECLARE parseData CHARACTER;

-- Get the input BLOB
SET myblob = InputRoot.BLOB.BLOB;

-- Convert BLOB to CHARACTER using UTF-8 encoding
SET parseData = CAST(myblob AS CHARACTER CCSID 1208);

-- Parse the CHARACTER data as JSON
CREATE LASTCHILD OF OutputRoot DOMAIN('JSON') PARSE(parseData CCSID 1208);
