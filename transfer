CREATE FUNCTION GetExceptionDetails(IN refExc REFERENCE) RETURNS CHARACTER
BEGIN
    DECLARE exceptionText CHARACTER '';
    DECLARE refNext REFERENCE TO refExc;

    -- Loop through all exceptions in the ExceptionList
    WHILE refNext IS NOT NULL DO
        -- Append exception details
        SET exceptionText = exceptionText || 
            'Type: ' || COALESCE(refNext.Type, 'N/A') || ', ' ||
            'Label: ' || COALESCE(refNext.Label, 'N/A') || ', ' ||
            'Number: ' || CAST(refNext.Number AS CHARACTER) || ', ' ||
            'Text: ' || COALESCE(refNext.Text, 'N/A') || '; ' || 
            '[Next Exception] ';

        -- Move to next exception
        MOVE refNext NEXTSIBLING;
    END WHILE;

    RETURN exceptionText;
END FUNCTION;

-- Extracting Exception List in Compute Node
SET OutputRoot.JSON.Data.ErrorDetails = GetExceptionDetails(InputExceptionList.*[1]);
