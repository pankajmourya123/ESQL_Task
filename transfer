CREATE COMPUTE MODULE SplitIntoIndividualFiles

CREATE FUNCTION Main() RETURNS BOOLEAN
BEGIN
    -- Fetch each record's values
    DECLARE refNo CHARACTER InputRoot.DFDL.RECORD.REF_NO;
    DECLARE msg CHARACTER InputRoot.DFDL.RECORD.MSG;
    DECLARE bankName CHARACTER InputRoot.DFDL.RECORD.BANKNAME;
    DECLARE creationTime CHARACTER InputRoot.DFDL.RECORD.CREATION_TIME;

    -- Clean up creationTime to avoid colons or spaces in file name
    DECLARE cleanTime CHARACTER REPLACE(REPLACE(creationTime, ":", ""), " ", "_");

    -- Construct file name
    DECLARE fileName CHARACTER refNo || '_' || bankName || '_' || cleanTime || '.txt';

    -- Set the target directory and file name
    SET OutputLocalEnvironment.Destination.File.Directory = 'C:/Users/pankaj.m/Desktop/P10/OUT2';
    SET OutputLocalEnvironment.Destination.File.Name = fileName;

    -- Set message body to MSG content only
    SET OutputRoot.BLOB.BLOB = CAST(msg AS BLOB CCSID 1208);

    RETURN TRUE;
END;

END MODULE;
