



CREATE COMPUTE MODULE flowtp_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		CALL CopyEntireMessage();
		RETURN TRUE;
	END;	



	CREATE PROCEDURE CopyEntireMessage() BEGIN

SET OutputRoot.JSON.Data.X=FIELDNAME(InputBody.*[<]);
SET OutputRoot.JSON.Data.Y=FIELDNAME(InputBody.F1.*[<]);
SET OutputRoot.JSON.Data.Z=FIELDNAME(InputBody.*[<].*[<]);
DECLARE ns NAMESPACE 'urn:nid:xxxxxx';

SET OutputRoot.JSON.Data.yY=FIELDNAME(InputBody.ns:F1.*[<]);
	END;
END MODULE;
