	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	

	CREATE PROCEDURE CopyEntireMessage() BEGIN
	DECLARE inputData CHARACTER;
		DECLARE errorMessage CHARACTER;
	
	
		SET inputData = FIELDNAME(InputRoot.JSON.Data);
	
		IF inputData IS NULL THEN
			SET errorMessage = 'Parsing Exception: Invalid ';

			THROW USER EXCEPTION
			SEVERITY 3
			CATALOG 'BIPmsgs'
			MESSAGE 2951
			VALUES(errorMessage);
		END IF;
		
	END;
END MODULE;






