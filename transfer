CREATE COMPUTE MODULE Task_Compute

    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        CALL CopyEntireMessage();
        RETURN TRUE;
    END;

    CREATE PROCEDURE CopyEntireMessage() 
    BEGIN
        -- Initialize variables
        DECLARE lineCount INTEGER 0;
        DECLARE currentLine REFERENCE TO InputRoot.BLOB.BLOB; -- Adjust based on your input structure
        DECLARE outputLines BLOB; -- To store the output lines

        -- Initialize output as an empty BLOB
        SET outputLines = CAST('' AS BLOB CCSID 1208); 

        -- Traverse through the input lines
        WHILE LASTMOVE(currentLine) DO
            IF lineCount < 10 THEN
                -- Append the current line to the output
                SET outputLines = outputLines || currentLine || CAST(CHAR(10) AS BLOB CCSID 1208); 
                SET lineCount = lineCount + 1;
            ELSE
                LEAVE; -- Exit the loop after processing 10 lines
            END IF;
            MOVE NEXT currentLine; -- Move to the next line
        END WHILE;

        -- Set the output root to the constructed output
        SET OutputRoot.BLOB.BLOB = outputLines;
    END;

END MODULE;
