CREATE PROCEDURE ConvertToXML() RETURNS BOOLEAN
BEGIN
    -- Declare a reference to the input and output
    DECLARE refInput REFERENCE TO InputRoot.BLOB.BLOB;
    DECLARE refOutput REFERENCE TO OutputRoot.XMLNSC.Records;

    -- Initialize the output structure
    CREATE FIELD OutputRoot.XMLNSC.Records;

    -- Parse the input text data
    DECLARE inputString CHAR;
    SET inputString = CAST(refInput AS CHAR CCSID 1208);

    -- Split the input into rows
    DECLARE rows LIST;
    SET rows = STRINGTOLIST(inputString, '\n');

    -- Skip the header row and process each data row
    DECLARE i INT 1;
    WHILE i <= LISTSIZE(rows) DO
        -- Split each row into columns (Name, Class, Age)
        IF i > 1 THEN
            DECLARE rowValues LIST;
            SET rowValues = STRINGTOLIST(LISTTOSTRING(rows[i]), ' ');

            -- Add a new Record in the output XML
            CREATE FIELD refOutput.Record;
            DECLARE refRecord REFERENCE TO refOutput.Record[LASTCHILD];

            CREATE FIELD refRecord.Name VALUE TRIM(rowValues[1]);
            CREATE FIELD refRecord.Class VALUE TRIM(rowValues[2]);
            CREATE FIELD refRecord.Age VALUE TRIM(rowValues[3]);
        END IF;
        SET i = i + 1;
    END WHILE;

    RETURN TRUE;
END;
