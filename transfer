DECLARE inputDateString CHARACTER '01-nov-2025';
DECLARE parsedDate DATE;
DECLARE formattedDateString CHARACTER;

-- Step 1: Parse the string to a DATE using the input format
SET parsedDate = CAST(inputDateString AS DATE FORMAT 'dd-MMM-yyyy');

-- Step 2: Format the DATE to desired string format
SET formattedDateString = CAST(parsedDate AS CHARACTER FORMAT 'dd-MM-yyyy');

-- Output the result (for debug or return)
RETURN formattedDateString;
