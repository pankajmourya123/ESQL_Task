DECLARE sourceCursor REFERENCE TO InputExceptionList;
MOVE sourceCursor FIRSTCHILD TYPE Name NAME 'Exception';  -- Move to the first exception

DECLARE targetCursor REFERENCE TO OutputRoot.JSON.Data.Exception[1]; -- Initialize the target reference
DECLARE i INTEGER 1;  -- Initialize counter

WHILE LASTMOVE(sourceCursor) DO  -- Loop until no more children
    SET targetCursor.Number = sourceCursor.Number;
    SET targetCursor.Text = sourceCursor.Text;
    SET targetCursor.Type = FIELDNAME(sourceCursor);
    
    -- Extract deeper exception details
    SET targetCursor.Text5 = sourceCursor.ParserException.ParserException.Text;
    SET targetCursor.Text1 = sourceCursor.ParserException.ParserException.Insert[5].Text;
    SET targetCursor.Text2 = sourceCursor.ParserException.ParserException.Insert[1].Text;

    -- Create the next sibling for the next exception
    CREATE NEXTSIBLING OF targetCursor AS targetCursor REPEAT;
    
    -- Move to the next exception in the list
    MOVE sourceCursor NEXTSIBLING REPEAT TYPE NAME;
    
    SET i = i + 1;
END WHILE;
