-- Step 1: Correct namespace declarations (without xmlns)
DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';
DECLARE tran NAMESPACE 'http://tempuri.org/Transaction';

CREATE COMPUTE MODULE MySoapFlow_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- Step 2: Reference to input (optional here, but kept for later use)
		DECLARE inref REFERENCE TO InputRoot.SOAP.Body.tran:transactionreq;

		-- Step 3: Set output namespaces
		SET OutputRoot.SOAP.Context.Namespace.(SOAP.NamespaceDecl)xmlns:soapenv = soapenv;
		SET OutputRoot.SOAP.Context.Namespace.(SOAP.NamespaceDecl)xmlns:tran = tran;

		-- Step 4: Create response element with correct namespace
		CREATE FIELD OutputRoot.SOAP.Body.tran:transactionres;
		DECLARE outRef REFERENCE TO OutputRoot.SOAP.Body.tran:transactionres;

		-- Step 5: Set values (you can also pull from inref)
		SET outRef.tran:TransactionId = inref.tran:TransactionId; -- input se value li
		SET outRef.tran:TransactionName = 'OnlinePurchase';
		SET outRef.tran:Amount = '500';
		SET outRef.tran:Status = 'Transaction is successful';

		RETURN TRUE;
	END;
END MODULE;
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tran="http://tempuri.org/Transaction">
   <soapenv:Header/>
   <soapenv:Body>
      <tran:transactionreq>
         <tran:TransactionId>101</tran:TransactionId>
      </tran:transactionreq>
   </soapenv:Body>
</soapenv:Envelope>
