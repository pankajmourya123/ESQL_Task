DECLARE inputString CHARACTER 'This is a test sentence.';
DECLARE targetChar CHARACTER 't';
DECLARE originalLength INT;
DECLARE modifiedLength INT;
DECLARE charCount INT;

-- Calculate the original length of the string
SET originalLength = LENGTH(inputString);

-- Remove all occurrences of the target character
SET inputString = REPLACE(inputString, targetChar, '');

-- Calculate the length of the modified string
SET modifiedLength = LENGTH(inputString);

-- Count of the target character
SET charCount = originalLength - modifiedLength;

-- Output the count
RETURN charCount;
