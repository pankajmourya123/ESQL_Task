

CREATE COMPUTE MODULE TaskMultithreding_Compute
	DECLARE shrvar Shared CHARACTER ;
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;

	

	
	CREATE PROCEDURE CopyEntireMessage() BEGIN ATOMIC
		
		
DECLARE xmlAsBlob BLOB ASBITSTREAM(InputRoot.XMLNSC CCSID 1208);
DECLARE xmlAsChar CHAR CAST(xmlAsBlob AS CHAR CCSID 1208);



DECLARE xmlAsJSON BLOB ASBITSTREAM(InputRoot.JSON.Data CCSID 1208);
DECLARE JSONAsChar CHAR CAST(xmlAsJSON AS CHAR CCSID 1208);

SET  shrvar = shrvar||xmlAsChar||JSONAsChar;

		
	END;
END MODULE;
