CREATE COMPUTE MODULE ReadRecords_Compute
  CREATE FUNCTION Main() RETURNS BOOLEAN
  BEGIN
    DECLARE I INTEGER 1;
    DECLARE TotalRecords INTEGER CARDINALITY(InputRoot.DFDL.xlsread.record[]);

    WHILE I <= TotalRecords DO
      DECLARE refNo CHARACTER InputRoot.DFDL.xlsread.record[I].REF_NO;
      DECLARE msg CHARACTER InputRoot.DFDL.xlsread.record[I].MSG;
      DECLARE bankName CHARACTER InputRoot.DFDL.xlsread.record[I].BANKNAME;
      DECLARE creationTime CHARACTER InputRoot.DFDL.xlsread.record[I].CREATION_TIME;

      -- Logging ya processing
      CALL CopyMessageHeaders();
      SET OutputLocalEnvironment.Variables.Records[I].REF_NO = refNo;
      SET OutputLocalEnvironment.Variables.Records[I].MSG = msg;
      SET OutputLocalEnvironment.Variables.Records[I].BANKNAME = bankName;
      SET OutputLocalEnvironment.Variables.Records[I].CREATION_TIME = creationTime;

      SET I = I + 1;
    END WHILE;

    RETURN TRUE;
  END;
END MODULE;
