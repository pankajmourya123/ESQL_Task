      </wsdl:input>
      <wsdl:output name="khuch_Output">
        <soap:body parts="res" use="literal"/>
      </wsdl:output>
      <wsdl:fault name="khuch_Fault">
        <soap:fault name="khuch_Fault" use="literal"/>
      </wsdl:fault>
