CREATE COMPUTE MODULE Timepass_Compute
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Initialize references
        DECLARE srcCursor REFERENCE TO InputRoot.XMLNSC.root.element[1]; -- Start at the first element
        DECLARE trgCursor REFERENCE TO OutputRoot.XMLNSC;

        -- Initialize OutputRoot structure
        CREATE LASTCHILD OF OutputRoot DOMAIN('XMLNSC') NAME 'root';

        -- Start processing elements
        DECLARE count INTEGER 0;
        WHILE LASTMOVE(srcCursor) DO
            -- Create a new element in OutputRoot
            CREATE LASTCHILD OF trgCursor NAME 'element';
            SET trgCursor.element.field = srcCursor.field;

            -- Move to the next sibling in the input
            MOVE srcCursor NEXTSIBLING;

            -- Increment count and break if 10 elements are processed
            SET count = count + 1;
            IF count = 10 THEN
                LEAVE;
            END IF;
        END WHILE;

        RETURN TRUE;
    END;
END MODULE;
