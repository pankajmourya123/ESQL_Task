import java.io.OutputStream;
import java.net.Socket;

public class TCPClient {
    public static void main(String[] args) throws Exception {
        String xml = "<person><name>Ravi</name><age>23</age></person>";
        Socket socket = new Socket("localhost", 14141); // must match the port in TCPIPServerInput node
        OutputStream out = socket.getOutputStream();
        out.write(xml.getBytes("UTF-8"));
        out.close();  // Closing socket signals message end
        socket.close();
        System.out.println("XML sent.");
    }
}
