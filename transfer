CREATE COMPUTE MODULE tsttt_Compute
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        CALL CopyEntireMessage();
        RETURN TRUE;
    END;

    CREATE PROCEDURE CopyEntireMessage() 
    BEGIN
        DECLARE count INTEGER;
        SET count = CARDINALITY(InputRoot.DFDL.test.record[]);
        
       
        SET OutputRoot.XMLNS.ROOT.name = InputRoot.DFDL.test.header.name;
        SET OutputRoot.XMLNS.ROOT.class = InputRoot.DFDL.test.header.class;
        SET OutputRoot.XMLNS.ROOT.age = InputRoot.DFDL.test.header.age;

         DECLARE records REFERENCE TO OutputRoot.XMLNS.ROOT.records[];

       DECLARE i INTEGER 1; 
        WHILE i <= count DO
           
            DECLARE newRecord REFERENCE TO records[i];
            SET newRecord.name = InputRoot.DFDL.test.record[i].name;
            SET newRecord.class = InputRoot.DFDL.test.record[i].class;
            SET newRecord.age = InputRoot.DFDL.test.record[i].age;
            SET i = i + 1;
        END WHILE;
    END;
END MODULE;
