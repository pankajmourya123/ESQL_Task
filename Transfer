



CREATE COMPUTE MODULE Map_code_flow_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyEntireMessage();
		RETURN TRUE;
	END;	



	CREATE PROCEDURE CopyEntireMessage() BEGIN
		DECLARE SENDERADDRESS CHARACTER 'APBL00000SC';
		DECLARE ORIGINATINGDATE CHARACTER '20250522';
		DECLARE UNIQUETRANSACTIONREF CHARACTER 'APELU25142296954';
		DECLARE BizmgsIdr CHARACTER ;
		
--BizmgsIdr	fn:concat( fn:substring($SENDERADDRESS1,0 ,5 ),$ORIGINATINGDATE2 ,'5',fn:substring($UNIQUETRANSACTIONREF1 ,8 ,9 ))
        SET BizmgsIdr = SUBSTRING(SENDERADDRESS FROM 1 FOR 5)
		|| ORIGINATINGDATE1
		|| '5'
		|| SUBSTRING(UNIQUETRANSACTIONREF FROM 8 FOR 9);
		
--credt fn:concat( fn:substring( $ORIGINATINGDATE,0 ,5 ),'-',fn:substring( $ORIGINATINGDATE,5 ,2 ),'-',fn:substring( $ORIGINATINGDATE,7 ,2 ),'T' ,fn:substring( $ORIGINATINGTIME,0 ,3 ),':',fn:substring( $ORIGINATINGTIME,3 ,2 ),':00Z');
		
		DECLARE credt CHARACTER;
		SET credt = SUBSTRING(ORIGINATINGDATE FROM 1 FOR 4)
		|| '-' || SUBSTRING(ORIGINATINGDATE FROM 5 FOR 2)
		|| '-' || SUBSTRING(ORIGINATINGDATE FROM 7 FOR 2)
		|| 'T' || SUBSTRING(ORIGINATINGTIME FROM 1 FOR 2)
		|| ':' || SUBSTRING(ORIGINATINGTIME FROM 3 FOR 2)
		|| ':00Z';
		
--IntrBkSttlmdt		fn:concat( fn:substring( $ORIGINATINGDATE3,0 ,5 ),'-',fn:substring( $ORIGINATINGDATE3,5 ,2 ),'-',fn:substring( $ORIGINATINGDATE3,7 ,2 ))
		DECLARE IntrBkSttlmdt CHARACTER;
		SET IntrBkSttlmdt = SUBSTRING(ORIGINATINGDATE3 FROM 1 FOR 4)
		|| '-' || SUBSTRING(ORIGINATINGDATE3 FROM 5 FOR 2)
		|| '-' || SUBSTRING(ORIGINATINGDATE3 FROM 7 FOR 2);
		
--MsgId  fn:concat( fn:substring($SENDERADDRESS1,0 ,5 ),$ORIGINATINGDATE2 ,'5',fn:substring($UNIQUETRANSACTIONREF1 ,8 ,9 ))		
		DECLARE MsgId CHARACTER;
		SET MsgId = SUBSTRING(SENDERADDRESS1 FROM 1 FOR 5)
		|| ORIGINATINGDATE2
		|| '5'
		|| SUBSTRING(UNIQUETRANSACTIONREF1 FROM 8 FOR 9);
		
--TxId   fn:concat( fn:substring($SENDERADDRESS2,0 ,5 ),'N','5',$VALUEDATE1,fn:substring($TRANSACTIONREFERENCENUMBER1 ,9 ,8 ))		
		DECLARE TxId CHARACTER;
		SET TxId = SUBSTRING(SENDERADDRESS2 FROM 1 FOR 5)
		|| 'N'
		|| '5'
		|| VALUEDATE1
		|| SUBSTRING(TRANSACTIONREFERENCENUMBER1 FROM 9 FOR 8);
		
--CredTm fn:concat( fn:substring( $VALUEDATE,0 ,5 ),'-',fn:substring( $VALUEDATE,5 ,2 ),'-',fn:substring( $VALUEDATE,7 ,2 ),'T' ,fn:substring( $ORIGINATINGTIME1,0 ,3 ),':',fn:substring( $ORIGINATINGTIME1,3 ,2 ),':00');		
		DECLARE CredTm CHARACTER;
		SET CredTm = SUBSTRING(VALUEDATE FROM 1 FOR 4)
		|| '-' || SUBSTRING(VALUEDATE FROM 5 FOR 2)
		|| '-' || SUBSTRING(VALUEDATE FROM 7 FOR 2)
		|| 'T' || SUBSTRING(ORIGINATINGTIME1 FROM 1 FOR 2)
		|| ':' || SUBSTRING(ORIGINATINGTIME1 FROM 3 FOR 2)
		|| ':00';
	END;
END MODULE;
