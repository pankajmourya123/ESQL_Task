

CREATE FILTER MODULE NEFT_PULL_Filter
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
	
		DECLARE Timing  TIME;
		DECLARE hr,min,sec CHARACTER;
		
		
		SET Timing=CAST(CURRENT_TIME as TIME FORMAT 'hh:mm:ss'); 
		SET hr=EXTRACT(HOUR FROM Timing);
		
		DECLARE hrlength INTEGER;
		SET hrlength = LENGTH(hr);
		
		WHILE hrlength < 2 DO
			SET hr = '0'||hr;
			SET hrlength = hrlength + 1; 
		END WHILE;
		
		IF hr ='06' THEN
			RETURN TRUE;
		ELSE
			RETURN FALSE;
		END IF;
		

	END;

END MODULE;

