		CALL log4j_1_1('IDENTIFY_BANK', 'APCOB_NEFT_IN', 'INFO','Bank Name: '||COALESCE(bankName,'NOT FOUND.')) INTO rc;	
		-----------------------------------N03-----------------------------ROHAN---------------------
		IF msgType = 'N03' THEN
			DECLARE recordRef REFERENCE TO inMsgDetailsref.*.body.record[>];
			WHILE LASTMOVE(recordRef) DO

				DECLARE qry2 CHARACTER 'SELECT IFSC_SENDER,IFSC_RECVR,INC_UTR FROM '||SCHEMANAME||'.'||NEFT_OUT_TABLE|| ' B WHERE  TRIM(B.TRAN_REF_NO)= ?';
