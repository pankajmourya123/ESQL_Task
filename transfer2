		CALL log4j_1_1('IDENTIFY_BANK', 'APCOB_NEFT_IN', 'INFO','Sender IFSC : '||sdrIfsc) INTO rc;
		CALL log4j_1_1('IDENTIFY_BANK', 'APCOB_NEFT_IN', 'INFO','Receiver IFSC :'||COALESCE(rcvrIfsc,'NOT APPLICABLE')) INTO rc;
		
--        SET newRecvrIfsc=SUBSTRING(rcvrIfsc FROM 1 FOR 4)||'%';
		SET newRecvrIfsc= rcvrIfsc||'%';
		SET newSdrIfsc=SUBSTRING(sdrIfsc from 1 for 4)||'%';
		
		DECLARE Qry CHARACTER 'SELECT A.BANKNAME FROM '||SCHEMANAME||'.'||TABLENAME||' A WHERE A.IFSC like ? ';
		
--  		IF msgtype = '972' THEN
--		     CALL log4j_1_1('IDENTIFY_BANK', 'APCOB_NEFT_IN', 'INFO','972 Statement No. : ' || InputRoot.DFDL.INF972.body.Statement_Number) INTO rc;
--			END IF;
