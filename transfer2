		IF msgIdentifier = 'F27' THEN
--			SET Qry = 'SELECT A.BANKNAME,A.TRAN_REF_NO,A.ACK_NACK FROM '||SCHEMANAME||'.'||NEFT_OUT_TABLE||' A WHERE A.SEQINHEADER = ? AND A.TRAN_DATE = ?';
